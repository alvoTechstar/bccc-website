# Point at the standalone backend (bccc-backend).
# Local dev (with `npm run dev` proxy): leave empty or use http://localhost:3001
VITE_API_URL=
# Production (live backend on Render):
VITE_API_URL=https://bccc-website-backend.onrender.com
# Admin dashboard: seeded super-admin email + password (first run only).
# Change these before sharing. New admins are created in Admin → Users.
VITE_ADMIN_EMAIL=admin@bccchurch.co.ke
VITE_ADMIN_PASSWORD=bcc-admin-2026-change-me
# Dedicated admin URL (recommended): host the console on its own subdomain
# so website visitors never land in it. Requires a DNS CNAME + the domain
# added to the same hosting project, then rebuild with this set:
# VITE_ADMIN_HOST=admin.bccchurch.co.ke
# Leave empty (local dev) and /admin/* works on every host.
VITE_ADMIN_HOST=
# "LIVE NOW" detection + watch-on-site player (optional but recommended):
# 1. https://console.cloud.google.com → new project → enable "YouTube Data API v3"
# 2. Credentials → Create API key → restrict it: "YouTube Data API v3" only,
#    HTTP referrers = your domain (e.g. https://bccchurch.co.ke/*) + http://localhost:5173/*
# 3. Paste below, restart `npm run dev` (and redeploy after changing hosting env).
# Without this key the site works as before — it just can't tell when you're live.
VITE_YOUTUBE_API_KEY=
